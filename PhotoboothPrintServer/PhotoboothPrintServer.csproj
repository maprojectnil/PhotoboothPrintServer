<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>PhotoboothPrintServer</RootNamespace>
		<AssemblyName>PhotoboothPrintServer</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<!-- Package resmi Microsoft, untuk query status printer via WMI -->
		<PackageReference Include="System.Management" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- Membawa Kestrel + Minimal API ke project WinForms (bukan paket NuGet) -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

</Project>